# Server Configuration
PORT=3001
NODE_ENV=production

# Eureka Configuration
EUREKA_APP_NAME=USER-SERVICE
EUREKA_HOST=localhost
EUREKA_PORT=8761

# MongoDB Configuration
# IMPORTANT: Change these credentials in production!
MONGODB_URI=mongodb://username:password@localhost:27017/bytebattle?authSource=admin

# RabbitMQ Configuration
# IMPORTANT: Change these credentials in production!
RABBITMQ_URL=amqp://username:password@localhost:5672

# JWT Configuration
# CRITICAL: Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_64_CHARACTER_SECRET_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_STRONG_64_CHARACTER_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=ByteBattle <noreply@bytebattle.com>

# WebAuthn / Face ID Configuration
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_ORIGIN=https://yourdomain.com

# OAuth Configuration (Google)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# OAuth Configuration (GitHub)
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://yourdomain.com/api/auth/github/callback

# Admin Bootstrap
ADMIN_SEED_ENABLED=true
ADMIN_SEED_SYNC_PASSWORD=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
# IMPORTANT: Use a strong password with uppercase, lowercase, numbers, and special characters
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5  # Max login attempts per window

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET
COOKIE_SECURE=true  # Set to true in production with HTTPS
COOKIE_SAME_SITE=strict
